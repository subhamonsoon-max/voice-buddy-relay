# Google AI Studio Gemini Developer API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Postgres Connection String (Free Tier)
# Example: postgresql://neondb_owner:password@ep-sample.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Server Config
PORT=8000
HOST=0.0.0.0

# Gemini Live Model (Real-time Audio)
LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest

# Primary Summarizer (Gemini Flash)
FLASH_MODEL=gemini-2.5-flash

# Optional Free Fallback Summarizer (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Available Gemini Live Voices:
# - Aoede: Cheerful, friendly, natural female voice (great for Anvi)
# - Zephyr: Bright, upbeat, youthful female voice (higher pitch / playful)
# - Kore: Gentle, warm, soothing female voice
# - Puck: Playful, energetic, high-pitched voice
# - Fenrir / Charon: Male voices
VOICE_NAME=Aoede
